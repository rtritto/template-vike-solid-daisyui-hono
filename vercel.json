{
  "outputDirectory": "dist/client",
  "devCommand": "vike dev",
  "builds": [
    {
      "src": "dist/server/index.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "dist/client/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/api/vercel-entry.js"
    }
  ]
}
